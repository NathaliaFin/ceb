# Conexao com o Postgres. No Railway isso vem preenchido automaticamente
# pela referencia de variavel ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ceb

# Nao ha usuario: basta digitar uma das duas senhas. As duas dao acesso
# completo (ver os cartoes, cadastrar e editar as familias).
# Senha compartilhada do grupo.
SENHA_VOLUNTARIO=troque-esta-senha

# Senha da administradora.
SENHA_ADMIN=troque-esta-senha-tambem

# Opcional: login no sistema da DPS (dpsfamilia.com.br), para o cartao
# mostrar se a visita do mes ja foi registrada la. Sem estas duas, nada muda.
DPS_USUARIO=
DPS_SENHA=
# Codigos do grupo e do subgrupo no sistema da DPS (4o Sabado / Paranoa04).
# DPS_GRUPO=3
# DPS_SUBGRUPO=2

# Chave usada para assinar o cookie de sessao. Gere uma aleatoria:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gere-uma-chave-aleatoria-longa
